@Component
script PatternFixer extends Component

	@ExecSpace("ServerOnly")
	method void OnInitialize()
		
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		for _, entity in pairs(self.Entity.Children) do
		    --if isvalid(entity.CustomFootholdComponent) and isvalid(entity.SpriteRendererComponent) then
		    if isvalid(entity.SpriteRendererComponent) then
				local sprite = entity.SpriteRendererComponent
		        sprite.Enable = false
		        
		        local modelId = "model://457a08c4-55c0-4e6d-884d-40a693a33625"
		        local newEntity = _SpawnService:SpawnByModelId(modelId, "sprite", Vector3.zero, entity)
		        newEntity.SpriteRendererComponent.SpriteRUID = sprite.SpriteRUID
		        newEntity.SpriteRendererComponent.DrawMode = sprite.DrawMode
		        newEntity.SpriteRendererComponent.TiledSize = sprite.TiledSize
				
				local rotate = math.rad(entity.TransformComponent.ZRotation)
				local direction = Vector3(math.cos(rotate), math.sin(rotate), 0)
				newEntity.TransformComponent.Position += direction * 4
		    end
		end
	end

end