@Component
script player extends Component

	property RigidbodyComponent rg = nil
	property number fixedX = nil
	property TransformComponent transform = nil

	property boolean canJump = true
	property boolean canDoubleJump = false
	property boolean canJumpSlide = false

	property boolean isGround = true
	property boolean isJumpSlide = false
	property boolean jumpSlideReleased = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.rg = self.Entity.RigidbodyComponent
		transform = self.Entity.TransformComponent

		local playerController = self.Entity.PlayerControllerComponent
		playerController:RemoveAllActionKeyByActionName("Jump")
		playerController:RemoveAllActionKeyByActionName("MoveDown")

		self.Entity.StateComponent:AddState("DOUBLEJUMP", DoubleJumpState)
		self.Entity.StateComponent:AddState("JUMPSLIDE", JumpSlideState)
		
		_TimerService:SetTimerOnce(function ()
			self.Entity.CameraComponent.DeadZone = Vector2(10,10)
			self.Entity.CameraComponent.SoftZone = Vector2(10,10)
		end,.5)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		transform.Position.x = self.fixedX
	end

	@ExecSpace("ClientOnly")
	method void ChangeCollider(string state)
		self.Entity.StateComponent:ChangeState(state)

		if state == "CROUCH" then
			self.Entity.TriggerComponent.BoxSize = _config.CrouchTriggerSize
			self.Entity.TriggerComponent.BoxOffset = _config.CrouchTriggerOffeset
		elseif state == "MOVE" then
			self.Entity.TriggerComponent.BoxSize = _config.StandTriggerSize
			self.Entity.TriggerComponent.BoxOffset = _config.StandTriggerOffeset
		end
	end

	@ExecSpace("ClientOnly")
	method void TryJump()
		self.rg:SetForce(Vector2(0,8))
		self.canDoubleJump = true
		self.canJumpSlide = true
		self.isGround = false
		self.Entity.StateComponent:ChangeState("JUMP")
	end

	@ExecSpace("ClientOnly")
	method void TryDoubleJump()
		self.rg:SetForce(Vector2(0,6))
		self.Entity.StateComponent:ChangeState("DOUBLEJUMP")
	end

	@ExecSpace("ClientOnly")
	method void TryJumpSlide()
		self.isJumpSlide = true
		self.canJumpSlide = false
		self.jumpSlideReleased = false
		self.Entity.StateComponent:ChangeState("JUMPSLIDE")
	end

	@ExecSpace("ClientOnly")
	method void EndJumpSlide()
		self.isJumpSlide = false
		self.Entity.StateComponent:ChangeState("JUMP")
	end

	-- 내부 헬퍼 메서드들은 위에서 호출하는 원본 함수 공간(ClientOnly)을 그대로 따라감.
	method void JumpLogic()
		if self.canJump then
			self.canJump = false
			self:TryJump()
		elseif self.canDoubleJump then
			self.canDoubleJump = false
			self:TryDoubleJump()
		end
	end

	-- 내부 헬퍼 메서드들은 위에서 호출하는 원본 함수 공간(ClientOnly)을 그대로 따라감
	method void SlideLogic()
		if self.isGround then
			self:ChangeCollider("CROUCH")
		elseif self.canJumpSlide then
			self:TryJumpSlide()
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		if event.key == KeyboardKey.Space then
			self:JumpLogic()
		end
		if event.key == KeyboardKey.DownArrow then
			self:SlideLogic()
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyUpEvent(KeyUpEvent event)
		if event.key == KeyboardKey.DownArrow then
			if self.isJumpSlide then
				self.jumpSlideReleased = true
			else
				self:ChangeCollider("MOVE")
			end
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleStateChangeEvent(StateChangeEvent event)
		if event.CurrentStateName == "MOVE" then
			self.isGround = true
			self.canJump = true
			self.canDoubleJump = false
			self.canJumpSlide = false
		end
	end

	-- @EventSender("Self")
	-- handler HandlePhysicsContactBeginEvent(PhysicsContactBeginEvent event)
	-- 	local ContactedBodyEntity = event.ContactedBodyEntity

	-- 	-- 충돌한 강체의 부모 오브젝트의 TileSet 컴포넌트를 가져옵니다.
	-- 	local tileSet = ContactedBodyEntity.Parent.PatternComponent

	-- 	-- 접촉한 오브젝트에서 타일셋이 검출되었다면
	-- 	if tileSet ~= nil then
			
	-- 		-- 접촉한 오브젝트의 Transform 컴포넌트를 가져옵니다.
	-- 		local contactTransform = ContactedBodyEntity.TransformComponent
	-- 		-- 캐릭터의 Transform 컴포넌트를 가져옵니다.
	-- 		local playerTransform = self.Entity.TransformComponent
			
	-- 		-- 만약 충돌체 대상의 오브젝트의 위치 y 값이 캐릭터의 위치 y 값 보다 더 높다면
	-- 		if contactTransform.Position.y >= playerTransform.Position.y then
	-- 			-- 해당 메서드 수행을 중단합니다.
	-- 			return
	-- 		end
			
	-- 		self.Entity.StateComponent:ChangeState("MOVE")
	-- 		self.isGround = true
	-- 		self.canJump = true
	-- 		self.canDoubleJump = false
	-- 		self.canJumpSlide = false
	-- 	end
	-- end

end
