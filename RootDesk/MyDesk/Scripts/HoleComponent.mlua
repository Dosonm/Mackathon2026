@Component
script HoleComponent extends Component

	property any Shape = nil

	property string SpawnLocationId = "SpawnLocation"

	property Entity SpawnLocation = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		local transform = self.Entity.TransformComponent
		local position = Vector2(transform.WorldPosition.x, transform.WorldPosition.y) 
		local size = Vector2(transform.Scale.x, transform.Scale.y) 
		self.Shape = BoxShape(position, size / 2, 0)
		
		self.SpawnLocation = _EntityService:GetEntityByTag(self.SpawnLocationId)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number dt)
		local transform = self.Entity.TransformComponent
		local position = Vector2(transform.WorldPosition.x, transform.WorldPosition.y) 
		self.Shape.Position = position
		
		local simulator = _CollisionService:GetSimulator(self.Entity)
		local overlaps = simulator:OverlapAll(CollisionGroups.Player, self.Shape)
			
		for _, overlap in pairs(overlaps) do
			if isvalid(overlap.Entity.PlayerComponent) then
				local curPosition = overlap.Entity.TransformComponent.WorldPosition
				self.SpawnLocation.TransformComponent.WorldPosition.x = curPosition.x - 1
		    	overlap.Entity.PlayerComponent:Respawn()
		    end
		end
	end

end