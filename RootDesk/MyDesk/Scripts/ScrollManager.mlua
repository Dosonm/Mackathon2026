@Component
script ScrollManager extends Component

	property SyncTable<string> patternTable

	property number totalLength = 0

	@HideFromInspector
	property Entity Player = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.Player = _EntityService:GetEntityByTag("Player")
		
		local length = self:GetSyncTableLength(self.patternTable)
		
		for i = 1, 3 do
			local index = math.random(length)
			local spawnPosition = Vector3(self.totalLength, 0, 0)
			
			local pattern
				= _SpawnService:SpawnByModelId(self.patternTable[index], "pattern", spawnPosition, self.Entity)
			if isvalid(pattern.PatternComponent) then
				self.totalLength += pattern.PatternComponent.patternLength
			end
		end
		
		self._T.object = 1
	end

	method integer GetSyncTableLength(SyncTable<string> table)
		local length = 0
		for _ in pairs(table) do
		    length += 1
		end
		
		return length
	end

end