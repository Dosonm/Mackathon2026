@Component
script ScrollManager extends Component

	property SyncTable<string> patternTable

	property number Speed = 1

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self._T.latestPatterns = {}
		self._T.pool = {}
		local length = _SyncTableExtend:GetLength(self.patternTable)
		for i = 1, length do
			table.insert(self._T.pool, {})
		end
		
		--self._T.totalLength = 0
		self._T.totalCount = 0
		self._T.patternEnd = 0
		self._T.patternTypeIndex = 1
		
		self:SpawnRandomPattern()
		self:SpawnRandomPattern()
		self:SpawnRandomPattern()
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		--if isvalid(self._T.player) == false then
		--    self._T.player = _EntityService:GetEntitiesSpawnedByModelId("model://defaultplayer")[1]
		--    if isvalid(self._T.player) == false then
		--        return
		--    end
		--end
		
		--if self._T.totalLength > 0 then
		    --local playerPosition = self._T.player.TransformComponent.WorldPosition
		    --local remainDistance = self._T.totalLength - playerPosition.x
			
			-- 남은 타일 길이고 10m보다 짧으면 풀링&배치
			if self._T.patternEnd < 20 then
		        if isvalid(self._T.latestPatterns[2]) then
		            self:ReleasePattern(self._T.latestPatterns[1])
		        end
				self:SpawnRandomPattern()
			end
		--else
		--    self:SpawnRandomPattern()
		--    self:SpawnRandomPattern()
		--end
		
		for _, pattern in pairs(self._T.latestPatterns) do
			pattern.TransformComponent.Position += Vector3.left * self.Speed * delta
		end
		self._T.patternEnd -= self.Speed * delta
	end

	method void SpawnRandomPattern()
		local length = _SyncTableExtend:GetLength(self.patternTable)
		
		local index = math.random(length)
		local spawnPosition = Vector3(self._T.patternEnd, 0, 0)
		
		local pattern = self:SpawnPattern(index, spawnPosition)
		table.insert(self._T.latestPatterns, pattern)
		
		if isvalid(pattern.PatternComponent) then
		    --self._T.totalLength += pattern.PatternComponent.patternLength
			self._T.totalCount += 1
			self._T.patternEnd += pattern.PatternComponent.patternLength
		else
			log("MISSING: PatternComponent-", pattern.Model.Name)
		end
	end

	method Entity SpawnPattern(integer idx, Vector3 position)
		local pattern = self:GetPattern(idx)
		
		pattern.Enable = true
		pattern.TransformComponent.WorldPosition = position
		
		return pattern
	end

	method Entity GetPattern(integer idx)
		local pattern = self._T.pool[idx][1]
			if pattern then
				table.remove(self._T.pool[idx], 1)
				return pattern
			end
		
		return self:CreatePattern(idx)
	end

	method Entity CreatePattern(integer idx)
		local pattern
			= _SpawnService:SpawnByModelId(self.patternTable[idx], "pattern", Vector3.zero, self.Entity)
		return pattern
	end

	method void ReleasePattern(Entity pattern)
		local idx = _SyncTableExtend:GetFirstIndex(self.patternTable, pattern.Model.Id)
		
		if idx >= 1 then
			pattern.Enable = false
			table.insert(self._T.pool[idx], pattern)
			table.remove(self._T.latestPatterns, 1)
		end
	end

end