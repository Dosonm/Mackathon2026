@Component
script player extends Component

	property any movement = nil

	property RigidbodyComponent rg = nil

	property boolean isReadyToJump = true

	property number landTimer = 0

	property boolean wasOnGround = true

	property number jumpCount = 0

	property ButtonComponent btnComponent = nil

	property number DoubleJumpSpeed = nil

	property number PlayerSpeed = nil

	method void OnBeginPlay()
		self.movement = self.Entity.MovementComponent
		self.rg = self.Entity.RigidbodyComponent
		self.PlayerSpeed = self.Entity.MovementComponent.InputSpeed
	end

	method void OnUpdate(number delta)
		self.movement:MoveToDirection(Vector2(1, 0) , delta)
	end

	method void Jump()
		self.jumpCount = 1
	end

	method void TryDoubleJump()
		log("jjump")
		if not self.rg:IsOnGround() and self.jumpCount == 1 then
			self.jumpCount = 2

			self.rg:SetForce(Vector2(self.PlayerSpeed*1.5,7))
		end
	end

	@EventSender("Self")
	handler HandleStateChangeEvent(StateChangeEvent event)
		if event.CurrentStateName == "MOVE" then
			self.jumpCount = 0
		end
	end

end