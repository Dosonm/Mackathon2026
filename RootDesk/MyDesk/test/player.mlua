@Component
script player extends Component

	property RigidbodyComponent rg = nil

	property number fixedX = nil

	property TransformComponent transform = nil

	@TargetUserSync
	property boolean canDoubleJump = false

	method void OnBeginPlay()
		self.rg = self.Entity.RigidbodyComponent
		transform = self.Entity.TransformComponent
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		transform.Position.x = self.fixedX
		
		-- if self.rg:IsOnGround() then
		-- 	self.canDoubleJump = false
		-- end
	end

	method void TryDoubleJump()
		log("jj")
		self.rg:SetForce(Vector2(0,7))
	end

	@EventSender("Self")
	handler HandleStateChangeEvent(StateChangeEvent event)
		if event.CurrentStateName == "MOVE" then
			self.canDoubleJump = false
		end
	end

	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		if event.ActionName == "Jump" then
			_TimerService:SetTimerOnce(function ()
				self.canDoubleJump = true
			end, 0.01)
		else
			self.canDoubleJump = false
		end
	end

end