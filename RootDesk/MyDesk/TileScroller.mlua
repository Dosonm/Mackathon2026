@Component
script TileScroller extends Component

	@Sync
	property Entity tiles = nil

	@Sync
	property Entity background = nil

	@Sync
	property number tileSpeed = 1

	@Sync
	property number backgroundSpeed = 0.5

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		self.tiles.TransformComponent.Position.x =
			self.tiles.TransformComponent.Position.x - self.tileSpeed * delta
		
		self.background.TransformComponent.Position.x =
			self.background.TransformComponent.Position.x - self.backgroundSpeed * delta
	end

end